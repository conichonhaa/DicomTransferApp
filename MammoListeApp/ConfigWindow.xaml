<Window x:Class="MammoListeApp.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration PACS"
        Height="320" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Paramètres de connexion PACS" FontSize="14" FontWeight="Bold" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP PACS Source :" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtPACSIP" Margin="0,0,0,8" Padding="4,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port PACS Source :" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtPACSPort" Margin="0,0,0,8" Padding="4,3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="AE Title PACS Source :" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtPACSAE" Margin="0,0,0,8" Padding="4,3"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Calling AE Title :" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtCallingAE" Margin="0,0,0,8" Padding="4,3"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="IP source (local) :" VerticalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtSourceIP" Margin="0,0,0,8" Padding="4,3"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Annuler" Width="90" Margin="0,0,10,0" IsCancel="True"/>
            <Button x:Name="btnSauvegarder" Content="Sauvegarder" Width="110" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
