<Window x:Class="DicomTransferApp.ConfigurationPACSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration PACS" Height="545" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PACS SOURCE Section -->
        <TextBlock Text="PACS SOURCE" FontWeight="Bold" FontSize="14" Grid.Row="0" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Text="IP / Hôte :" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
            <TextBox x:Name="txtPACSSourceIP" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Port :" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2"/>
            <TextBox x:Name="txtPACSSourcePort" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBlock Text="AE Title :" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
            <TextBox x:Name="txtPACSSourceAE" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"/>

            <TextBlock Text="Source IP / Hôte :" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
            <TextBox x:Name="txtSourceIP" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Port :" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2"/>
            <TextBox x:Name="txtSourcePort" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBlock Text="Source AE Title :" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0"/>
            <TextBox x:Name="txtSourceAE" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" VerticalAlignment="Center"/>

            <TextBlock Text="Source Calling AE :" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2"/>
            <TextBox x:Name="txtSourceCallingAE" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"/>
        </Grid>

        <!-- PACS DESTINATION Section -->
        <TextBlock Text="PACS DESTINATION" FontWeight="Bold" FontSize="14" Grid.Row="3" Margin="0,0,0,10"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Text="IP / Hôte :" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
            <TextBox x:Name="txtDestIP" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Port :" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2"/>
            <TextBox x:Name="txtDestPort" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>

            <TextBlock Text="AE Title :" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
            <TextBox x:Name="txtDestAE" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"/>

            <TextBlock Text="Usurper AE :" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
            <TextBox x:Name="txtUsurperAE" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center"/>
        </Grid>

        <!-- File Configuration Section -->
        <Border Grid.Row="6" Background="#FFF9E6" Padding="10" BorderBrush="#FFD700" BorderThickness="1">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11">
                    <Run Text="📁 Configuration sauvegardée dans un fichier .conf"/>
                </TextBlock>
                <Button x:Name="btnOuvrirFichier" Content="Ouvrir le fichier" 
                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="5,2"
                        Click="BtnOuvrirFichier_Click"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="8" Margin="0,10,0,0">
            <Button x:Name="btnSauvegarder" Content="Sauvegarder" Width="100" Margin="0,0,10,0" Padding="5"
                    Click="BtnSauvegarder_Click"/>
            <Button x:Name="btnAnnuler" Content="Annuler" Width="100" Padding="5"
                    Click="BtnAnnuler_Click"/>
        </StackPanel>
    </Grid>
</Window>
